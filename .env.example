# ---------------------------------------------------------------------------
# SecureVault - local development environment
#
# Copy to `.env.local`:
#     cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit real secrets.
# Docker Compose additionally auto-loads `.env` (not `.env.local`) for
# variable substitution - see docker-compose.yml.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# PostgreSQL connection string.
# These defaults match the PostgreSQL service in docker-compose.yml
# (host port ${DB_PORT:-5433}). If you change DB_PASSWORD or DB_NAME in
# `.env`, keep this value in sync.
DATABASE_URL=postgresql://vault_admin:vault_secret_2024@localhost:5433/password_vault

# AES-256-GCM key for encrypting stored credentials.
# Must be EXACTLY 64 hex characters (32 bytes). Generate one with:
#     openssl rand -hex 32
#   or
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# There is currently no key-rotation path. Back this value up securely:
# changing or losing it makes every encrypted credential unrecoverable.
ENCRYPTION_KEY=

# Secret used to sign session JWTs (HS256). Generate one with:
#     openssl rand -base64 32
# Rotating this invalidates all active sessions (users must log in again).
SESSION_SECRET=

# --- Seed script only (prisma/seed.ts) -------------------------------------

# The seed creates a demo team. These three variables override the first
# (super admin) account. The password is printed to stdout on every run.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# --- Docker Compose only ---------------------------------------------------

# Overrides for the postgres service. Read from `.env`, not `.env.local`.
# The values below are the compose defaults; override them for any shared or
# long-lived environment.
DB_HOST=localhost
DB_PORT=5433
DB_USER=vault_admin
DB_PASSWORD=vault_secret_2024
DB_NAME=password_vault
