{
  "name": "secure-vault",
  "version": "0.1.0",
  "description": "Self-hosted credential administration system with AES-256-GCM encryption at rest, append-only audit logging, RBAC, and a configurable password policy.",
  "license": "MIT",
  "author": "Najm Alzorqah",
  "homepage": "https://github.com/NajmAlzorqah/secure-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NajmAlzorqah/secure-vault.git"
  },
  "bugs": {
    "url": "https://github.com/NajmAlzorqah/secure-vault/issues"
  },
  "keywords": [
    "password-manager",
    "vault",
    "credentials",
    "secrets-management",
    "encryption",
    "aes-256-gcm",
    "rbac",
    "audit-log",
    "security",
    "nextjs",
    "prisma",
    "postgres"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && tsx prisma/setup-triggers.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-intl": "^4.13.7",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/zxcvbn": "^4.4.5",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
